#!/bin/sh
# Post-push hook: restore the local hardware/distro-specific hyprland config
# files that were replaced by pre-push.

MONITORS="hyprland/.config/hypr/monitors.lua"
AUTOSTART="hyprland/.config/hypr/autostart.lua"
MONITORS_BACKUP="$MONITORS.local.bak"
AUTOSTART_BACKUP="$AUTOSTART.local.bak"

if [ -f "$MONITORS_BACKUP" ]; then
    mv "$MONITORS_BACKUP" "$MONITORS"
fi

if [ -f "$AUTOSTART_BACKUP" ]; then
    mv "$AUTOSTART_BACKUP" "$AUTOSTART"
fi